# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Untuk fungsionalitas role admin
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron Job & Sinkronisasi Harga Pangan (https://harga-pangan.fly.dev)
CRON_SECRET=your_random_secure_cron_secret
PRICE_API_BASE_URL=https://harga-pangan.fly.dev
PRICE_DEFAULT_PROVINCE=Jawa Barat
